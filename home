    header('Location: login.php');
    exit;
}

$userId = $_SESSION['user_id'];
$tasks = [];
$error = '';

try {
    $pdo = new PDO($dsn, $db_user, $db_password, [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC
    ]);
    
    // Инициализируем таблицу (добавляем новые поля если нужно)
    initDatabase($pdo);

    // Получаем задачи с приоритетом и датой создания
    $stmt = $pdo->prepare("SELECT id, text, complite, priority, created_at FROM tasks WHERE user_id = ? ORDER BY created_at DESC");
