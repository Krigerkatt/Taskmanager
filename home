      <div class="priority-option high" data-value="high">Высокий</div>
    </div>
    <input type="hidden" name="priority" id="taskPriority" value="medium">

    <div class="buttons">
      <button type="submit">Сохранить</button>
      <button type="button" id="cancelModalBtn">Отмена</button>
    </div>
  </form>
</dialog>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('modal');
  const cancelBtn = document.getElementById('cancelModalBtn');
  const addBtn = document.getElementById('addActiveBtn');
  const editBtns = document.querySelectorAll('.btn-edit');
  const priorityOptions = document.querySelectorAll('.priority-option');
  const priorityInput = document.getElementById('taskPriority');
  const sortSelects = document.querySelectorAll('.sort-select');
  const lists = document.querySelectorAll('#activeList, #doneList');
  
  let draggedItem = null;

  // Выбор приоритета
  priorityOptions.forEach(option => {
    option.addEventListener('click', function() {
      priorityOptions.forEach(o => o.classList.remove('selected'));
      this.classList.add('selected');
      priorityInput.value = this.dataset.value;
    });
  });

  // Открытие модального окна для новой задачи
  if (addBtn) {
    addBtn.addEventListener('click', function() {
      document.getElementById('modalAction').value = 'add';
      document.getElementById('modalId').value = '';
      document.getElementById('taskTextarea').value = '';
      document.getElementById('modalTitle').textContent = 'Новая задача';
      priorityOptions.forEach(o => o.classList.remove('selected'));
      document.querySelector('.priority-option.medium').classList.add('selected');
      priorityInput.value = 'medium';
      modal.showModal();
    });
  }

  // Открытие модального окна для редактирования
  editBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('modalAction').value = 'edit';
      document.getElementById('modalId').value = this.dataset.id;
      document.getElementById('taskTextarea').value = this.dataset.text;
      document.getElementById('modalTitle').textContent = 'Редактировать задачу';
      
      // Устанавливаем приоритет
      const currentPriority = this.dataset.priority || 'medium';
      priorityOptions.forEach(o => {
        o.classList.remove('selected');
        if (o.dataset.value === currentPriority) {
          o.classList.add('selected');
        }
      });
      priorityInput.value = currentPriority;
      
      modal.showModal();
    });
  });

  if (cancelBtn) {
    cancelBtn.addEventListener('click', function() {
      modal.close();
    });
  }

  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        modal.close();
      }
    });
  }

  // Сортировка задач
  sortSelects.forEach(select => {
    select.addEventListener('change', function() {
      const column = this.dataset.column;
      const listId = column === 'active' ? 'activeList' : 'doneList';
      const list = document.getElementById(listId);
      const items = Array.from(list.querySelectorAll('li'));
      
      const sortBy = this.value;
      
      items.sort((a, b) => {
        if (sortBy === 'created_desc') {
          return new Date(b.dataset.created) - new Date(a.dataset.created);
        } else if (sortBy === 'created_asc') {
          return new Date(a.dataset.created) - new Date(b.dataset.created);
        } else if (sortBy === 'priority_high') {
          const priorityOrder = { high: 0, medium: 1, low: 2 };
          return priorityOrder[a.dataset.priority] - priorityOrder[b.dataset.priority];
        } else if (sortBy === 'priority_low') {
          const priorityOrder = { low: 0, medium: 1, high: 2 };
          return priorityOrder[a.dataset.priority] - priorityOrder[b.dataset.priority];
        }
      });
      
      items.forEach(item => list.appendChild(item));
    });
  });

  // Drag and Drop
  lists.forEach(list => {
    list.addEventListener('dragstart', function(e) {
      draggedItem = e.target;
      e.target.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
    });

    list.addEventListener('dragend', function(e) {
      e.target.classList.remove('dragging');
      draggedItem = null;
      document.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
    });

    list.addEventListener('dragover', function(e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      const afterElement = getDragAfterElement(list, e.clientY);
      if (draggedItem && draggedItem !== e.target) {
        if (afterElement == null) {
          list.appendChild(draggedItem);
        } else {
          list.insertBefore(draggedItem, afterElement);
        }
      }
    });

    list.addEventListener('drop', function(e) {
      e.preventDefault();
      const taskId = draggedItem.dataset.id;
      const newColumn = list.dataset.column;
      const newComplite = newColumn === 'done' ? 1 : 0;
      
      // Отправляем AJAX запрос для обновления статуса
      fetch('form.php', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: `action=move_task&id=${taskId}&complite=${newComplite}`
      })
      .then(response => response.text())
      .then(data => {
        // Перезагружаем страницу для обновления счетчиков
        window.location.reload();
      })
      .catch(error => {
        console.error('Error:', error);
      });
    });
  });

  function getDragAfterElement(container, y) {
    const draggableElements = [...container.querySelectorAll('li:not(.dragging)')];

    return draggableElements.reduce((closest, child) => {
      const box = child.getBoundingClientRect();
      const offset = y - box.top - box.height / 2;
      if (offset < 0 && offset > closest.offset) {
        return { offset: offset, element: child };
      } else {
        return closest;
      }
    }, { offset: Number.NEGATIVE_INFINITY }).element;
  }
});
</script>
